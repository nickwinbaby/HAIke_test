{
  "name": "Power 12V to 14.5V with CAN simulation",
  "power": {
    "baudrate": 9600,
    "current": 2.0,
    "initial_voltage": 0.0,
    "keyword": ""
  },
  "can": {
    "backend": "winusb",
    "vid": "0x04D8",
    "pid": "0x0053",
    "channel_index": 0,
    "bitrate": 500000
  },
  "steps": [
    {
      "name": "Search and connect programmable power supply USB",
      "action": "power.connect"
    },
    {
      "name": "Set power supply to 12V and enable output",
      "action": "power.set_voltage",
      "voltage": 12.0,
      "output": "on"
    },
    {
      "name": "Wait 60 seconds",
      "action": "wait",
      "seconds": 60
    },
    {
      "name": "Ramp 12V to 14.5V within 2 seconds",
      "action": "power.ramp_voltage",
      "from": 12.0,
      "to": 14.5,
      "duration": 2,
      "steps": 20
    },
    {
      "name": "Start CAN simulation",
      "action": "can.start"
    },
    {
      "name": "Keep CAN running for 2 minutes",
      "action": "wait",
      "seconds": 120
    },
    {
      "name": "Stop CAN simulation",
      "action": "can.stop"
    },
    {
      "name": "Ramp 14.5V down to 12V within 2 seconds",
      "action": "power.ramp_voltage",
      "from": 14.5,
      "to": 12.0,
      "duration": 2,
      "steps": 20
    },
    {
      "name": "Wait 90 seconds",
      "action": "wait",
      "seconds": 90
    },
    {
      "name": "Power off to 0V",
      "action": "power.output_off",
      "voltage": 0.0
    }
  ]
}
