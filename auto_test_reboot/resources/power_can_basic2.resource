${RELAY_OFF_STATE}    open

*** Keywords ***
Prepare Power And Can
    Configure Power Supply    ${POWER_CURRENT_A}
    Configure Can Simulation    ${CAN_ID_FORMAT}    ${CAN_BITRATE}    ${CAN_CHANNEL_INDEX}
    Configure Vehicle Data Fields

Configure Vehicle Data Fields
    Set Can Signal Range    speed    ${CAN_SPEED_MIN_KPH}    ${CAN_SPEED_MAX_KPH}
    Set Can Signal Range    rpm    ${CAN_RPM_MIN}    ${CAN_RPM_MAX}
    Set Can Signal Value    A    ${CAN_COOLANT_TEMP_FIXED_C}
    Set Can Signal Value    B    ${CAN_THROTTLE_FIXED_PERCENT}
    Set Can Signal Value    C    ${CAN_ENGINE_LOAD_FIXED_PERCENT}
    Set Can Signal Value    D    ${CAN_MAF_FIXED_GPS}
    Set Can Signal Value    E    ${CAN_INTAKE_TEMP_FIXED_C}
    Set Can Signal Value    F    ${CAN_INTAKE_PRESSURE_FIXED_KPA}
    Set Can Signal Value    G    ${CAN_VEHICLE_BATTERY_VOLTAGE_FIXED_V}
    Set Can Signal Value    H    ${CAN_FUEL_LEVEL_FIXED_PERCENT}
    Set Can Signal Value    I    ${CAN_DTC_CLEARED_DISTANCE_FIXED_KM}
    Set Can Signal Value    J    ${CAN_MIL_DISTANCE_FIXED_KM}
    Set Can Signal Value    K1    ${CAN_HISTORICAL_MILEAGE_FIXED_M}
    Set Can Signal Value    K2    ${CAN_HISTORICAL_FUEL_FIXED_ML}
    Set Can Signal Value    K3    ${CAN_HISTORICAL_DRIVING_TIME_FIXED_S}
    Set Can Signal Value    L    ${CAN_SEATBELT_STATUS_FIXED}
    Set Can Signal Value    M    ${CAN_ODOMETER_FIXED_KM}
    Set Can Signal Value    N    ${CAN_AVERAGE_FUEL_FIXED_ML_100KM}
    Set Can Signal Value    O    ${CAN_ODOMETER_UNIT_FIXED}
    Set Can Signal Value    P    ${CAN_SOC_FIXED_PERCENT}
    Set Can Signal Value    Q    ${CAN_SOH_FIXED_PERCENT}
    Set Can Signal Value    R    ${CAN_BATTERY_CURRENT_FIXED_A}
    Set Can Signal Value    S    ${CAN_BATTERY_VOLTAGE_FIXED_V}
    Set Can Signal Value    T    ${CAN_CHARGING_STATE_FIXED}
    Set Can Signal Value    U    ${CAN_REMAINING_RANGE_FIXED_KM}
    Set Can Signal Value    V    ${CAN_BATTERY_TEMP_FIXED_C}
    Set Can Signal Value    W    ${CAN_NEXT_SERVICE_DISTANCE_FIXED_KM}
    Set Can Signal Value    X    ${CAN_ENGINE_RUN_TIME_FIXED_S}
    Set Can Signal Value    Y    ${CAN_FUEL_TYPE_FIXED}
    Set Can Signal Value    Z    ${CAN_TURN_SIGNAL_STATUS_FIXED}
    Set Can Signal Value    engine_oil_pressure    ${CAN_OIL_PRESSURE_FIXED_KPA}
    Set Can Signal Value    def_tank_volume    ${CAN_DEF_TANK_FIXED_PERCENT}
    Set Can Signal Value    transmission_gear    ${CAN_TRANSMISSION_GEAR_FIXED}
    Set Can Signal Value    accelerator_pedal    ${CAN_ACCELERATOR_PEDAL_FIXED_PERCENT}
    Set Can Signal Value    brake_pedal    ${CAN_BRAKE_PEDAL_FIXED_PERCENT}
    Set Can Signal Value    clutch_slip    ${CAN_CLUTCH_SLIP_FIXED_PERCENT}

Prepare Relay
    Connect Relay Usb
    Set Relay Channel    ${RELAY_CHANNEL}    ${RELAY_ON_STATE}

Power On Device
    Connect Power Supply Usb
    Wait Seconds    ${POWER_PRE_ON_DELAY_SECONDS}
    Set Power Current    ${POWER_CURRENT_A}
    Set Power Voltage    ${POWER_ON_VOLTAGE}    on
    Wait Seconds    ${START_WAIT_SECONDS}
    Ramp Power Voltage    ${POWER_ON_VOLTAGE}    ${POWER_HIGH_VOLTAGE}    ${RAMP_SECONDS}    ${RAMP_STEPS}

Run Can Period
    Start Can Simulation
    Wait Seconds    ${CAN_RUN_SECONDS}
    Stop Can Simulation

Return Power To Normal
    Ramp Power Voltage    ${POWER_HIGH_VOLTAGE}    ${POWER_ON_VOLTAGE}    ${RAMP_SECONDS}    ${RAMP_STEPS}
    Wait Seconds    ${END_WAIT_SECONDS}

Run Power Can Relay Config Flow
    Configure Runtime    ${DRY_RUN}    ${TIME_SCALE}
    Prepare Power And Can
    Prepare Relay
    Power On Device
    Run Can Period
    Return Power To Normal
    Set Relay Channel    ${RELAY_CHANNEL}    ${RELAY_OFF_STATE}
    Power Off To Zero
